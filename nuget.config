<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Every dependency of this package is on nuget.org. <clear /> keeps sources from a
    user-level NuGet.Config (several machines still define the old Azure feed) out of the
    build, so what Publish.ps1 packs does not depend on the machine it runs on.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
